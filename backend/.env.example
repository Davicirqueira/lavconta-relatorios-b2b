# ==========================================================================
# Backend (FastAPI) — variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser versionado (já coberto pelo .gitignore).
# ==========================================================================

# String de conexão do Postgres do Supabase.
# SENSÍVEL: dá acesso total ao banco. Só em variável de ambiente, nunca no código.
#
# USE O "SESSION POOLER", não a conexão direta.
#   Motivo: a conexão direta (db.<ref>.supabase.co) publica apenas registro AAAA,
#   ou seja, exige IPv6. Em rede IPv4 ela é inalcançável (verificado em 24/09/2026).
#   O Session pooler atende em IPv4 na porta 5432.
#
#   NÃO use o Transaction pooler (porta 6543): nele a conexão volta ao pool a cada
#   transação, o que atrapalha DDL do Alembic e prepared statements.
#
# No Session pooler o usuário inclui o ref do projeto: postgres.<ref-do-projeto>
# Copie a URI do painel (Connect > Session pooler) e troque apenas o prefixo
# "postgresql://" por "postgresql+psycopg://" (driver psycopg 3).
#
# Formato: postgresql+psycopg://postgres.<ref>:senha@aws-N-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# URL do JWKS do projeto Supabase (chaves públicas para validar a assinatura do JWT).
# Ex.: https://<ref-do-projeto>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Emissor esperado do JWT (claim "iss"). Deve bater com o que o Supabase emite.
SUPABASE_JWT_ISSUER=

# Audiência esperada do JWT (claim "aud"). Normalmente "authenticated".
SUPABASE_JWT_AUDIENCE=

# Origens permitidas para CORS, separadas por vírgula. Sem coringa.
# Ex.: http://localhost:5173,https://lavconta.netlify.app
CORS_ORIGENS=
