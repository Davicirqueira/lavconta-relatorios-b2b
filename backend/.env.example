# ==========================================================================
# Backend (FastAPI) — variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser versionado (já coberto pelo .gitignore).
# ==========================================================================

# String de conexão do Postgres do Supabase.
# SENSÍVEL: dá acesso total ao banco. Só em variável de ambiente, nunca no código.
# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
DATABASE_URL=

# URL do JWKS do projeto Supabase (chaves públicas para validar a assinatura do JWT).
# Ex.: https://<ref-do-projeto>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Emissor esperado do JWT (claim "iss"). Deve bater com o que o Supabase emite.
SUPABASE_JWT_ISSUER=

# Audiência esperada do JWT (claim "aud"). Normalmente "authenticated".
SUPABASE_JWT_AUDIENCE=

# Origens permitidas para CORS, separadas por vírgula. Sem coringa.
# Ex.: http://localhost:5173,https://lavconta.netlify.app
CORS_ORIGENS=
