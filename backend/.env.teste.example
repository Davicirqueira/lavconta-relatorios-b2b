# ==========================================================================
# Configuração do banco LOCAL de testes
#
# Copie para .env.teste e preencha a senha. O .env.teste NÃO é versionado.
#
# Por que um banco local e não o Supabase: os testes de constraint criam e
# removem tabelas. Rodar isso no banco de produção seria risco desnecessário.
# O Postgres local é rápido, offline e descartável.
#
# O banco 'lavconta_teste' é criado pelo script:
#   scripts/redefinir-senha-postgres-local.ps1
# ==========================================================================

# Senha definida para o usuário 'postgres' da instância local.
DATABASE_URL_TESTE=postgresql+psycopg://postgres:SUA_SENHA@localhost:5432/lavconta_teste
