# ==========================================================================
# Segredos e variáveis de ambiente — NUNCA versionar
# (barreira configurada antes de qualquer arquivo sensível existir)
# ==========================================================================
.env
.env.*
# os arquivos de exemplo SÃO versionados (só têm nomes de chave, sem valores).
# A segunda exceção é necessária porque "!.env.example" não cobre nomes
# compostos como ".env.teste.example".
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
.secrets/
*.local

# ==========================================================================
# Python / Backend
# ==========================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================================================
# Node / Frontend
# ==========================================================================
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ==========================================================================
# IDE / Sistema operacional
# ==========================================================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
