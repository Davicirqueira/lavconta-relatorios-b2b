# ==========================================================================
# Frontend (React + Vite) — variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais.
#
# ATENÇÃO: toda variável VITE_* vai para o bundle e é PÚBLICA por definição.
# NUNCA colocar segredo de servidor aqui (ex.: service_role, senha de banco).
# ==========================================================================

# URL do projeto Supabase (pública).
# Ex.: https://<ref-do-projeto>.supabase.co
VITE_SUPABASE_URL=

# Chave anônima (anon) do Supabase. Pública por design — protegida por escopo/RLS.
VITE_SUPABASE_ANON_KEY=

# URL base da API FastAPI.
# Ex.: http://localhost:8000 (dev) ou https://lavconta-api.onrender.com (prod)
VITE_API_URL=
